+package util.tools.machineLearning;
+
+/**
+ * Basic examples for using {@link ClienteTCP_ML}.
+ */
+public final class ClienteTCP_ML_ExemplosUso {
+
+    private ClienteTCP_ML_ExemplosUso() {
+        // Utility class.
+    }
+
+    public static void main(String[] args) {
+        exemploUsoBasico();
+        exemploConfiguracaoPorParametro();
+    }
+
+    public static void exemploUsoBasico() {
+        String message = "HEALTH_CHECK";
+        String response = ClienteTCP_ML.sendAndReceiveMessage(message);
+
+        if (response.isEmpty()) {
+            System.out.println("Falha: servidor nao respondeu apos todas as tentativas.");
+        } else {
+            System.out.println("Resposta do servidor: " + response);
+        }
+    }
+
+    public static void exemploConfiguracaoPorParametro() {
+        String response = ClienteTCP_ML.sendAndReceiveMessage("TEST", "localhost", 7766);
+        System.out.println("Resposta usando endpoint explicito: " + response);
+    }
+
+    public static void exemploConfiguracaoPorSystemProperties() {
+        System.setProperty("ml.server.host", "localhost");
+        System.setProperty("ml.server.port", "7766");
+        System.setProperty("ml.connect.timeout", "10000");
+        System.setProperty("ml.socket.timeout", "5000");
+        System.setProperty("ml.max.retries", "3");
+
+        String response = ClienteTCP_ML.sendAndReceiveMessage("TEST");
+        System.out.println("Resposta usando System Properties: " + response);
+    }
+
+    public static void exemploCoreAssignment() {
+        int circuitId = 100;
+        int requiredBandwidth = 50;
+        int hops = 5;
+        double osnr = 15.5;
+
+        String mlRequest = String.format("ASSIGN_CORE/%d/%d/%d/%.2f", circuitId, requiredBandwidth, hops, osnr);
+        String mlResponse = ClienteTCP_ML.sendAndReceiveMessage(mlRequest);
+
+        if (!mlResponse.isEmpty()) {
+            System.out.println("Circuito " + circuitId + " => resposta ML: " + mlResponse);
+        }
+    }
+}
