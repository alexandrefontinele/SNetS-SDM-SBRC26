+			double coreUtilization = 0.0;
+			for (Link link : route.getLinkList()) {
+				coreUtilization += link.getCore(core).getUsedSlots();
+			}
+			
+			coreUtilization = coreUtilization / route.getLinkList().size();
+			
+			CoreComp coreTemp = new CoreComp(core, coreUtilization);
+			if(core == 0) {
+				coreZero = coreTemp;
+			} else {
+				coreList.add(coreTemp);
+			}
+		}
+		
+		coreList.sort(Comparator.comparing(CoreComp::getUtilization));
+		if (coreZero != null) {
+			coreList.add(coreZero); //Adiciona o nucleo zero por ultimo
+		}
+		
+		return coreList;
