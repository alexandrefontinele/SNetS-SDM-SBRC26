+        res.append(valueOrEmpty(getXT())).append(DataSetManager.strSeparator);
+        res.append(valueOrEmpty(getOSNR())).append(DataSetManager.strSeparator);
+
+        for (Integer utilization : coreUtilization) {
+            res.append(valueOrEmpty(utilization)).append(DataSetManager.strSeparator);
+        }
+
+        res.append(valueOrEmpty(getWasBlocked())).append(DataSetManager.strSeparator);
+        res.append(valueOrEmpty(getBlockCause())).append(DataSetManager.strSeparator);
+
+        return res.toString();
+    }
+
+    @Override
+    public void setDatasetStructure(ControlPlane cp, Circuit c) {
+        if (cp == null) {
+            throw new IllegalArgumentException("ControlPlane cannot be null");
+        }
+        if (c == null) {
+            throw new IllegalArgumentException("Circuit cannot be null");
+        }
+
+        int numberOfCores = cp.getMesh().maximumCoresByLinks();
+
+        setBandwidth(c.getRequiredBitRate());
+        setWasBlocked(c.isWasBlocked());
+        setBlockCause(c.getBlockCause());
+
+        if (c.getRoute() != null) {
+            setHops(c.getRoute().getHops());
+            setLength(c.getRoute().getDistanceAllLinks());
+        } else {
+            setHops(0);
+            setLength(0.0);
+        }
+
+        setCore(c.getIndexCore());
+        setModulation(c.getModulation() == null ? null : c.getModulation().getM());
+
+        int[] spectrumAssigned = c.getSpectrumAssigned();
+        if (spectrumAssigned != null && spectrumAssigned.length >= 2) {
+            setFirstSlot(spectrumAssigned[0]);
+            setLastSlot(spectrumAssigned[1]);
+        } else {
+            setFirstSlot(-1);
+            setLastSlot(-1);
+        }
+
+        setXT(c.getXt());
+        setOSNR(c.getSNR());
+        setCoreUtilization(createCoreUtilization(c, numberOfCores));
+    }
+
+    private static List<Integer> createCoreUtilization(Circuit circuit, int numberOfCores) {
+        List<Integer> utilization = new ArrayList<>(Math.max(0, numberOfCores));
+        int[] spectrumUtilization = circuit.getSpectrumUtilizationAbsolut();
+
+        for (int i = 0; i < numberOfCores; i++) {
+            int value = 0;
+            if (spectrumUtilization != null && i < spectrumUtilization.length) {
+                value = spectrumUtilization[i];
+            }
+            utilization.add(value);
+        }
+
+        return utilization;
+    }
