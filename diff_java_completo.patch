+    "min_class_size = min(np.bincount(y_train))\n",
+    "\n",
+    "X_train_resampled, y_train_resampled = [], []\n",
+    "for class_label in np.unique(y_train):\n",
+    "    X_class = X_train[y_train == class_label]\n",
