+#!/usr/bin/env python3
+"""Train an MLP model for core prediction.
+
+This script replaces the old mlpCore-2.py with a configurable, portable version.
+"""
+
+from __future__ import annotations
+
+import argparse
+import time
+from pathlib import Path
+
+import pandas as pd
+import tensorflow as tf
+from sklearn.model_selection import train_test_split
+from sklearn.preprocessing import MinMaxScaler
+
+
+def build_model(input_dim: int, num_classes: int) -> tf.keras.Model:
+    model = tf.keras.Sequential(
+        [
+            tf.keras.layers.Input(shape=(input_dim,)),
+            tf.keras.layers.Dense(128, activation="relu"),
+            tf.keras.layers.Dense(64, activation="relu"),
+            tf.keras.layers.Dense(32, activation="relu"),
+            tf.keras.layers.Dense(num_classes, activation="softmax"),
+        ]
+    )
+    model.compile(
+        optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),
+        loss="categorical_crossentropy",
+        metrics=["accuracy"],
+    )
+    return model
+
+
+def train(args: argparse.Namespace) -> None:
+    start = time.time()
+    input_csv = Path(args.input).expanduser().resolve()
+    output_model = Path(args.output).expanduser().resolve()
+    checkpoint_path = output_model.with_name(output_model.stem + "_best.keras")
+
+    if not input_csv.exists():
+        raise FileNotFoundError(f"Input CSV not found: {input_csv}")
+
+    data = pd.read_csv(input_csv).drop_duplicates()
+    if args.target not in data.columns:
+        raise ValueError(f"Target column '{args.target}' was not found in {input_csv}")
+
+    y = data[args.target].astype(int) - args.label_offset
+    x = data.drop(columns=[args.target])
+
+    scaler = MinMaxScaler() if args.normalize else None
+    x_values = scaler.fit_transform(x) if scaler is not None else x.values
+
+    y_values = tf.keras.utils.to_categorical(y, num_classes=args.num_classes)
+
+    x_train, x_val, y_train, y_val = train_test_split(
+        x_values,
+        y_values,
+        test_size=args.validation_size,
+        random_state=args.seed,
+        stratify=y if args.stratify else None,
+    )
+
+    model = build_model(input_dim=x_train.shape[1], num_classes=args.num_classes)
+
+    callbacks = [
+        tf.keras.callbacks.EarlyStopping(
+            monitor="val_loss",
+            min_delta=args.min_delta,
+            patience=args.patience,
+            restore_best_weights=True,
+        ),
+        tf.keras.callbacks.ModelCheckpoint(
+            filepath=str(checkpoint_path),
+            monitor="val_loss",
+            save_best_only=True,
+        ),
+    ]
+
+    model.fit(
+        x_train,
+        y_train,
+        validation_data=(x_val, y_val),
+        epochs=args.epochs,
+        batch_size=args.batch_size,
+        callbacks=callbacks,
+        verbose=1,
+    )
+
+    output_model.parent.mkdir(parents=True, exist_ok=True)
+    model.save(output_model)
+
+    elapsed = time.time() - start
+    print(f"Saved model: {output_model}")
+    print(f"Best checkpoint: {checkpoint_path}")
+    print(f"Training time: {elapsed:.2f} seconds")
+
+
+def build_arg_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="Train an MLP core prediction model.")
+    parser.add_argument("--input", default="baseMLJurandir4.csv", help="Input CSV file")
+    parser.add_argument("--target", default="Core", help="Target column name")
+    parser.add_argument("--output", default="treinoCoreMLPbaseMLJurandir4.keras", help="Output model path")
+    parser.add_argument("--num-classes", type=int, default=6)
+    parser.add_argument("--label-offset", type=int, default=1, help="Subtract this value from target labels before one-hot encoding")
+    parser.add_argument("--epochs", type=int, default=1000)
+    parser.add_argument("--batch-size", type=int, default=64)
+    parser.add_argument("--patience", type=int, default=20)
+    parser.add_argument("--min-delta", type=float, default=0.0004)
+    parser.add_argument("--validation-size", type=float, default=0.2)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--normalize", action="store_true")
+    parser.add_argument("--no-stratify", dest="stratify", action="store_false")
+    parser.set_defaults(stratify=True)
+    return parser
+
+
+def main() -> None:
+    train(build_arg_parser().parse_args())
+
+
+if __name__ == "__main__":
+    main()
