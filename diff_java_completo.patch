+package gprmcsa.powerAssignment;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.TreeSet;
+import java.util.Vector;
+import java.util.stream.Collectors;
+
+import gprmcsa.modulation.Modulation;
+import gprmcsa.routing.Route;
+import network.Circuit;
+import network.ControlPlane;
+import network.Core;
+import network.Link;
+import network.PhysicalLayer;
+
+public class FMPA_v2 implements PowerAssignmentAlgorithmInterface {
+
+	@Override
+	public double assignLaunchPower(Circuit circuit, Route route, Modulation modulation, int core, int[] spectrumAssigned, ControlPlane cp) {
+		
+		//For the PABS algorithm to work correctly the PSD must be variable.
+		if (cp.getMesh().getPhysicalLayer().getFixedPowerSpectralDensity()) {
+			cp.getMesh().getPhysicalLayer().setFixedPowerSpectralDensity(false);
+		}
+		
+		double launchPower = FairMarginAwarePowerAssignment(circuit, route, modulation, core, spectrumAssigned, cp);
+		circuit.setLaunchPowerLinear(launchPower);
+		
+		return launchPower;
+	}
+	
+	/**
+	 * This method applies the FMPA power assignment strategy.
+	 * 
+	 * @param circuit Circuit
+	 * @param route Route
+	 * @param modulation Modulation
+	 * @param core int
+	 * @param spectrumAssigned int[]
+	 * @param cp ControlPlane
+	 * @return double
+	 */
+    public double FairMarginAwarePowerAssignment(Circuit circuit, Route route, Modulation modulation, int core, int spectrumAssigned[], ControlPlane cp){
+    	
+    	//To avoid mistakes
+		circuit.setRoute(route);
+		circuit.setModulation(modulation);
+		circuit.setIndexCore(core);
+		circuit.setSpectrumAssigned(spectrumAssigned);
+    	
+    	
+		double OSNRcurrent = 0.0;
+		double XTcurrent = 0.0;
+		double obj = 0.0;
+		double Pnorm = 0.0;
+		double selfMargin = 0.0;
+		double selfMarginNorm = 0.0;
+		double neighborMarginNorm = 0.0;
+		double XTselfNorm = 0.0;
+		double XTneighborsNorm = 0.0;
+		
+		double OSNRth = modulation.getSNRthresholdLinear(); //Linear
+		double XTth = modulation.getXTthresholdLinear(); //Linear
+		//OSNRth = OSNRth + this.margin; //margin is linear
+		
+		double Plow = 1.0E-11; //W, -80 dBm
+		double Pmax = computePmax(circuit, cp);
+		double Pmin = computePmin(circuit, Plow, Pmax, cp);
+		
+		// OSNR do próprio circuito (selfMargin)
+		double alphaMin = 0.4; // rede pesada, menos egoísmo
+		double alphaMax = 0.9; // rede leve, pensa mais em si
+		
+		// OSNR dos vizinhos
+		double betaMin = 0.2; // rede leve, pouca interferência, menos preocupação com vizinhos
+		double betaMax = 0.9; // rede pesada, protege fortemente vizinhos
+		
+		// Penalização de potência
+		double gammaMin = 0.05; // quase não penaliza potência em rede vazia
+		double gammaMax = 0.3; // penalização bem mais forte em rede cheia
+		
+		// XT do próprio circuito (XTself)
+		double deltaMin = 0.2; // Rede leve: menos crítico -> peso moderado
+		double deltaMax = 0.7; // Rede pesada: muito crítico -> peso alto
+		
+		// XT nos vizinhos (XTneighbors)
+		double thetaMin = 0.2; // Rede leve: pouca interferência -> peso moderado
+		double thetaMax = 0.8; // Rede pesada: altamente crítico -> peso alto (quase igual δ)
+		
+		double w = 0.7; // Peso média ponderada (global + local)
+		double rho = measureNetworkLoad(circuit, w, cp); // Ajusta de acordo com a carga da rede
+		
+		double alpha = alphaDynamic(rho, alphaMin, alphaMax);
+        double beta  = betaDynamic(rho, betaMin, betaMax);
+        double gamma = gammaDynamic(rho, gammaMin, gammaMax);
+        double delta = deltaDynamic(rho, deltaMin, deltaMax);
+        double theta = thetaDynamic(rho, thetaMin, thetaMax);
+        
+        double lambdaSmooth = 5.0; // por exemplo, mais alto ≈ min "mais duro"
+
+        List<Double> P_candidates = generateCandidatePowers(circuit, Pmin, Pmax, cp);
+
+        double bestObj = Double.NEGATIVE_INFINITY;
+        
+	    // Retorna a média geométrica caso nenhum candidato válido apareça
+	    Double bestP = Math.sqrt(Pmin * Pmax);
+
+        for (double P : P_candidates) {
+        	
+        	circuit.setLaunchPowerLinear(P); // Configura a nova potência no cirucito em analise
+        	
+        	//====================================================
+        	// OSNR do próprio circuito
+        	OSNRcurrent = computeOSNR(circuit, cp, null, false);
+    		selfMargin = OSNRcurrent - OSNRth;
+            if (selfMargin < 0.0) {
+            	continue; // bloqueio QoTN
+            }
+            
+            selfMarginNorm = Math.tanh(selfMargin / OSNRth); // Margem do próprio circuito normalizada usando tanh
+            
+            //====================================================
+            // XT do próprio circuito
+            XTcurrent = computeXT(circuit, cp, null, false);
+            if (XTcurrent > XTth) {
+            	continue; // bloqueio por XTN
+            }
+            
+            XTselfNorm = 1.0 - (XTcurrent / XTth); // XT próprio normalizado (maior = melhor)
+            if (XTselfNorm < 0.0) XTselfNorm = 0.0;
+            if (XTselfNorm > 1.0) XTselfNorm = 1.0;
+            
+            //====================================================
+            // OSNR nos circuitos afetados (QoTO via OSNR)
+            OSNRNeighborInfo infoOSNR = computeOSNRNeighborInfo(circuit, lambdaSmooth, cp);
+            if (infoOSNR.violatesThreshold) {
+            	continue; // pior vizinho estourou margem OSNR
+            }
+            
+            neighborMarginNorm = infoOSNR.smoothMarginNorm; // Margem dos vizinhos normalizada
+            
+            //====================================================
+            // XT nos circuitos vizinhos (QoTO via XT)
+            XTNeighborInfo infoXT = computeXTNeighborsInfo(circuit, lambdaSmooth, cp);
+            if (infoXT.violatesThreshold) {
+                continue; // algum vizinho excedeu limiar de XT
+            }
+            
+            XTneighborsNorm = infoXT.smoothQuality; //XT dos vizinhos
+            
+            //====================================================
+            Pnorm = Math.sqrt(P / Pmax); // Potência normalizada com raiz quadrada
+            
+            obj = objectiveFunctionJ(circuit, Pnorm, alpha, beta, gamma, delta, theta, selfMarginNorm, neighborMarginNorm, XTselfNorm, XTneighborsNorm, cp);
+            
+            if (obj > bestObj) {
+            	bestObj = obj;
+                bestP = P;
+            }
+        }
+
+        return bestP;
+	}
+    
+    /**
+     * Estrutura para retorno combinado da análise de vizinhos
+     */
+    public static class OSNRNeighborInfo {
+        public double minOSNRmargin;
+        public double smoothMarginNorm;
+        public boolean violatesThreshold;
+        
+        public OSNRNeighborInfo(double margin, double smoothMarginNorm, boolean violatesThreshold) {
+            this.minOSNRmargin = margin;
+            this.smoothMarginNorm = smoothMarginNorm;
+            this.violatesThreshold = violatesThreshold;
+        }
+    }
+    
+    /**
+     * Função combinada: pior vizinho + pior threshold
+     * - minMarginRaw: margem do pior vizinho (para QoT e ε)
+     * - smoothMarginNorm: smooth-min das margens normalizadas (para função J)
+     * 
+     * @param circuit Circuit
+     * @param lambdaSmooth double
+     * @param cp ControlPlane
+     * @return NeighborInfo
+     */
+    public OSNRNeighborInfo computeOSNRNeighborInfo(Circuit circuit, double lambdaSmooth, ControlPlane cp) {
+        HashSet<Circuit> neighbors = new HashSet<Circuit>(); // Circuit list for test
+		
+		// Search for all circuits that have links in common with the circuit under evaluation
+        Route route = circuit.getRoute();
+	    for (Link link : route.getLinkList()) {
+	    	// Picks up the active circuits that use the link
+	        for (Circuit circuitTemp : link.getCore(circuit.getIndexCore()).getCircuitList()) {
+	        	// If the circuit is different from the circuit under evaluation and is not in the circuit list for test
+	        	if (!circuit.equals(circuitTemp) && !neighbors.contains(circuitTemp)) {
+	                neighbors.add(circuitTemp);
+	        	}
+	        }
+	    }
+		
+	    // Se NÃO EXISTEM vizinhos
+	    if (neighbors.isEmpty()) {
+	        return new OSNRNeighborInfo(0.0, 1.0, false); // (minOSNRmargin = neutro, smoothMarginNorm = neutro, nenhum vizinho violou threshold)
+	    }
+	    
+		double minOSNRmargin = Double.POSITIVE_INFINITY;
+		double sumExp = 0.0; // Para smooth-min sobre margens normalizadas
+		boolean violates = false;
+
+		// Tests the QoT of circuits
+		for (Circuit neighbor : neighbors) {
+			
+			//Test this way so as not to alter the SNR and QoT of the circuit under evaluation.
+			double OSNR = computeOSNR(neighbor, cp, circuit, true);
+			double OSNRthreshold = neighbor.getModulation().getSNRthresholdLinear();
+			double OSNRmargin = OSNR - OSNRthreshold; // Margem não normalizada
+			
+			// Atualiza margem (para QoT)
+			if (OSNRmargin < minOSNRmargin) { 
+                minOSNRmargin = OSNRmargin;
+			}
+			
+			// Margem normalizada por OSNRth individual
+            // (assim comparamos "quantos thresholds" acima/abaixo)
+            double marginNorm = OSNRmargin / OSNRthreshold;
+            
+            // Acumula para smooth-min
+            // smoothMin(m_i) = -(1/λ) * ln( Σ exp(-λ m_i) )
+            sumExp += Math.exp(-lambdaSmooth * marginNorm);
+            
+            // Verifica violação
+            if (OSNRmargin < 0.0) {
+                violates = true;
+            }
+		}
+		
+        // Smooth-min das margens normalizadas
+        double smoothMinNorm = (-1.0 / lambdaSmooth) * Math.log(sumExp);
+
+        return new OSNRNeighborInfo(minOSNRmargin, smoothMinNorm, violates);
+    }
+    
+    /**
+     * Estrutura para retorno combinado da análise de XT nos vizinhos.
+     * - minQuality: pior "qualidade" XT (mais crítico) entre os vizinhos
+     * - smoothQuality: smooth-min das qualidades XT (usado na função objetivo)
+     * - violatesThreshold: true se QUALQUER vizinho ficar acima do limiar de XT
+     */
+    public static class XTNeighborInfo {
+        public double minQuality;
+        public double smoothQuality;
+        public boolean violatesThreshold;
+
+        public XTNeighborInfo(double minQuality, double smoothQuality, boolean violatesThreshold) {
+            this.minQuality = minQuality;
+            this.smoothQuality = smoothQuality;
+            this.violatesThreshold = violatesThreshold;
+        }
+    }
+    
+    /**
+     * Analisa o XT que o circuito 'circuit' causa em seus vizinhos.
+     * Retorna:
+     *  - minQuality: pior qualidade (menor q_k)
+     *  - smoothQuality: smooth-min das qualidades
+     *  - violatesThreshold: se algum vizinho excede XTth
+     *
+     * @param circuit       Circuito avaliado (agressor)
+     * @param lambdaSmooth  parâmetro de suavização (mesmo estilo do OSNR)
+     * @param cp            ControlPlane
+     * @return XTNeighborInfo
+     */
+    public XTNeighborInfo computeXTNeighborsInfo(Circuit circuit, double lambdaSmooth, ControlPlane cp) {
+
+    	TreeSet<Circuit> neighbors = new TreeSet<Circuit>();
+
+        Route route = circuit.getRoute();
+        for(Link link: route.getLinkList()) {
+			ArrayList<Core> adjacentsCores = link.getAdjacentCores(circuit.getIndexCore());			
+			for(Core core : adjacentsCores) {
+				for(Circuit adjacentCircuit : core.getCircuitList()) {
+					if(cp.getMesh().getPhysicalLayer().getCrosstalk().isIntersection(circuit.getSpectrumAssigned(), adjacentCircuit.getSpectrumAssigned())) {
+						if(!neighbors.contains(adjacentCircuit)) {
+							neighbors.add(adjacentCircuit);
+						}
+					}
+				}
+			}
+		}
+
+        // Caso não existam vizinhos: XT não é um fator aqui.
+        if (neighbors.isEmpty()) {
+            return new XTNeighborInfo(1.0, 1.0, false); // (minQuality: melhor possível, smoothQuality, ninguém viola nada)
+        }
+
+        double minQuality = Double.POSITIVE_INFINITY;
+        double sumExp = 0.0;
+        boolean violates = false;
+
+        for (Circuit neighbor : neighbors) {
+
+            // XT que o vizinho "neighbor" sofre por causa de "circuit"
+            double XTk = computeXT(neighbor, cp, circuit, true);
+            double XTth_k = neighbor.getModulation().getXTthresholdLinear();
+
+            if (XTk > XTth_k) {
+                violates = true;
+            }
+
+            // qualidade XT: quanto mais perto de 1, melhor.
+            double qk = 1.0 - (XTk / XTth_k);
+
+            // clamp em [0,1]
+            if (qk < 0.0) qk = 0.0;
+            if (qk > 1.0) qk = 1.0;
+
+            if (qk < minQuality) {
+                minQuality = qk;
+            }
+
+            // smooth-min sobre as "qualidades"
+            // smoothMin(q_i) = -(1/λ) * ln( Σ exp(-λ q_i) )
+            sumExp += Math.exp(-lambdaSmooth * qk);
+        }
+
+        double smoothQuality = (-1.0 / lambdaSmooth) * Math.log(sumExp);
+
+        return new XTNeighborInfo(minQuality, smoothQuality, violates);
+    }
+    
+    /**
+     * Função Objetivo J(P)
+     * 
+     * @param circuit Circuit
+     * @param Pm double
+     * @param alpha double
+     * @param beta double
+     * @param gamma double
+     * @param delta double
+     * @param theta double
+     * @param selfMargin double
+     * @param neighborMargin double
+     * @param XTself double
+     * @param XTneighbors double
+     * @param cp ControlPlane
+     * @return double
+     */
+    public double objectiveFunctionJ(Circuit circuit, double Pm, double alpha, double beta, double gamma, double delta, double theta, double selfMargin, double neighborMargin, double XTself, double XTneighbors,  ControlPlane cp) {
+		double res = (alpha * selfMargin) + (beta * neighborMargin) + (delta * XTself) + (theta * XTneighbors) - (gamma * Pm);
+		return res;
+	}
+    
+    /**
+     * Função Objetivo J(P) com cálculo de grandezas normalizadas
+     * 
+     * @param circuit Circuit
+     * @param Pm double
+     * @param alpha double
+     * @param beta double
+     * @param gamma double
+     * @param delta double
+     * @param Pmax double
+     * @param lambdaSmooth double
+     * @param epsQoTO double
+     * @param cp ControlPlane
+     * @return double
+     */
+    public double objectiveFunction(Circuit circuit, double Pm, double alpha, double beta, double gamma, double delta, double theta, double Pmax, double lambdaSmooth, ControlPlane cp) {
+    	circuit.setLaunchPowerLinear(Pm); // Configura a nova potência no cirucito em analise
+    	
+    	double Pnorm = Math.sqrt(Pm / Pmax); // Potência normalizada com raiz quadrada
+    	
+    	//=============================================
+    	// OSNR do novo circuito
+    	double OSNRcurrent = computeOSNR(circuit, cp, null, false);
+    	double OSNRthreshold = circuit.getModulation().getSNRthresholdLinear();
+		double selfMargin = OSNRcurrent - OSNRthreshold;
+		
+		// Se a margem é negativa -> candidato inválido
+	    if (selfMargin < 0.0) {
+	        return Double.NEGATIVE_INFINITY;
+	    }
+	    
+	    // Normalização com tanh (intervalo [-1,1])
+		double selfMarginNorm = Math.tanh(selfMargin / OSNRthreshold);
+		
+		//=============================================
+        // XT do novo circuito
+        double XTm = computeXT(circuit, cp, null, false);
+        double XTthreshold = circuit.getModulation().getXTthresholdLinear();
+        
+        // Verifica se excede o limiar -> candidato inválido
+        if (XTm > XTthreshold) {
+            return Double.NEGATIVE_INFINITY;
+        }
+
+        // XT normalizado para [0,1]
+        double XTnorm = 1.0 - (XTm / XTthreshold);
+        
+        // Clampeia por segurança
+        if (XTnorm < 0.0) XTnorm = 0.0;
+        if (XTnorm > 1.0) XTnorm = 1.0;
+        
+        //=============================================
+        // OSNR dos vizinhos (QoTO via OSNR)
+        OSNRNeighborInfo infoOSNR = computeOSNRNeighborInfo(circuit, lambdaSmooth, cp);
+        
+        // Restrição de QoTO
+        if (infoOSNR.violatesThreshold) {
+            return Double.NEGATIVE_INFINITY;
+        }
+
+        double neighborMarginNorm = infoOSNR.smoothMarginNorm; // Margem dos vizinhos normalizada
+        
+        //=============================================
+        // XT nos vizinhos (QoTO via XT)
+        XTNeighborInfo infoXT = computeXTNeighborsInfo(circuit, lambdaSmooth, cp);
+        
+    	// Restrição de QoTO
+        if (infoXT.violatesThreshold) {
+            return Double.NEGATIVE_INFINITY; // Algum vizinho estourou XTth
+        }
+
+        double XTneighborsNorm = infoXT.smoothQuality;
+        
+        //=============================================
+        // Avaliação da função objetivo
+		double res = objectiveFunctionJ(circuit, Pnorm, alpha, beta, gamma, delta, theta, selfMarginNorm, neighborMarginNorm, XTnorm, XTneighborsNorm, cp);
+		return res;
+	}
+
+    /**
+     * Função que gera uma lista de potências candidatas.
+     * A lista de potências é gerada usando as estratégias Log-Uniforme e Linear Uniforme.
+     * 
+     * @param Pmin double
+     * @param Pmax double
+     * @return List<Double>
+     */
+    public List<Double> generateCandidatePowers(Circuit circuit, double Pmin, double Pmax, ControlPlane cp) {
+    	//Lista de potências candidatas
+    	List<Double> candidates = new ArrayList<>();
+    	
+    	// -----------------------------------------------------
+        // (1) Obter carga da rede ρ (valores entre 0 e 1)
+    	// passamos w=0.7 como padrão para priorizar caminho (rota).
+    	// -----------------------------------------------------
+    	double rho = measureNetworkLoad(circuit, 0.7, cp);
+    	
+    	// -----------------------------------------------------
+        // (2) Cálculo automático da quantidade total de amostras
+    	//    Depende de:
+        //    - Amplitude do intervalo de potência (ordens de grandeza)
+        //    - Carga da rede (rho)
+    	// -----------------------------------------------------
+    	double ratio = Pmax / Pmin;
+        double orders = Math.log10(ratio);
+
+        int N = (int)(10 + 3 * orders + 10 * rho);
+        
+        // Limites de segurança (para não exagerar em rede muito pesada)
+        if (N < 12) N = 12;
+        if (N > 40) N = 40;
+
+        // Divisão entre log-uniforme e uniforme
+        int Nlog  = N / 2;
+        int Nunif = N - Nlog;
+
+        // Segurança
+        if (Nlog < 4)  Nlog  = 4;
+        if (Nunif < 4) Nunif = 4;
+
+        // ----------------------------------
+        // 3) Amostragem Log-Uniforme
+        //    Para baixa potência e regiões críticas
+        // ----------------------------------
+        for (int i = 0; i < Nlog; i++) {
+            double ratioLog = (double)i / (Nlog - 1);
+            double P = Pmin * Math.pow(Pmax / Pmin, ratioLog);
+            candidates.add(P);
+        }
+
+        // ----------------------------------
+        // 4) Amostragem Linear Uniforme
+        //    Para cobrir todo intervalo
+        // ----------------------------------
+        for (int i = 0; i < Nunif; i++) {
+            double P = Pmin + i * (Pmax - Pmin) / (Nunif - 1);
+            candidates.add(P);
+        }
+
+        // ----------------------------------
+        // 5) Garantir extremos
+        // ----------------------------------
+        candidates.add(Pmin);
+        candidates.add(Pmax);
+    	
+        // ----------------------------------
+        // 6) Remover duplicatas + ordenar
+        // ----------------------------------
+        List<Double> finalCandidates = candidates.stream().distinct().sorted().collect(Collectors.toList());
+        
+        return finalCandidates;
+	}
+    
+    /**
+     * Função para cálculo de α(ρ)
+     * Diminui com a carga (menos egoísmo)
+     * 
+     * @param p double
+     * @param alphaMin double
+     * @param alphaMax double
+     * @return double
+     */
+    public double alphaDynamic(double p, double alphaMin, double alphaMax) { 
+        return alphaMax - (alphaMax - alphaMin) * p;
+    }
+    
+    /**
+     * Função para cálculo de β(ρ)
+     * Aumenta com a carga (protege vizinhos)
+     * 
+     * @param p double
+     * @param betaMin double
+     * @param betaMax double
+     * @return double
+     */
+    public double betaDynamic(double p, double betaMin, double betaMax) { 
+    	return betaMin + (betaMax - betaMin) * p;
+    }
+    
+    /**
+     * Função para cálculo de γ(ρ)
+     * Aumenta com a carga (penaliza potência alta)
+     * 
+     * @param p double
+     * @param gammaMin double
+     * @param gammaMax double
+     * @return double
+     */
+    public double gammaDynamic(double p, double gammaMin, double gammaMax) { 
+    	return gammaMin + (gammaMax - gammaMin) * p;
+    }
+    
+    /**
+     * Peso δ(ρ) — controla a importância de reduzir XT sob carga alta.
+     * δ aumenta com a carga da rede.
+     * 
+     * @param p double
+     * @param deltaMin double
+     * @param deltaMax double
+     * @return double
+     */
+    public double deltaDynamic(double p, double deltaMin, double deltaMax) {
+    	return deltaMin + (deltaMax - deltaMin) * p;
+    }
+
+    /**
+	 * Peso θ(ρ) para XT nos vizinhos.
+     * Também aumenta com a carga, para proteger mais os vizinhos quando a rede está cheia.
+     * 
+     * @param p double
+     * @param thetaMin double
+     * @param thetaMax double
+     * @return double
+     */
+    public double thetaDynamic(double p, double thetaMin, double thetaMax) {
+        return thetaMin + (thetaMax - thetaMin) * p;
+    }
+     
+    /**
+     * Cálculo da carga da rede ρ ∈ [0,1]
+     * 
+     * @param circuit  circuit
+     * @param w double
+     * @param cp ControlPlane
+     * @return double
+     */
+    public double measureNetworkLoad(Circuit circuit, double w, ControlPlane cp) {
+        
+    	Vector<Link> allLinks = cp.getMesh().getLinkList();
+    	Vector<Link> routeLinks = circuit.getRoute().getLinkList();
+    	int circuitCore = circuit.getIndexCore();
+    	
+    	double usedGlobal = 0.0;
+    	double totalGlobal = 0.0;
+    	double utGlobal = 0.0;
+    	for (Link tLink : allLinks) {
+			usedGlobal += tLink.getCore(circuitCore).getUsedSlots();
+			totalGlobal += tLink.getCore(circuitCore).getNumOfSlots();
+    	}
+    	
+    	if (totalGlobal > 0.0) {
+    		utGlobal = usedGlobal / totalGlobal;
+    	}
+    	
+    	double usedRoute = 0.0;
+    	double totalRoute = 0.0;
+    	double utLocal = 0.0;
+		for (Link rLink : routeLinks) {
+			usedRoute += rLink.getCore(circuitCore).getUsedSlots();
+			totalRoute += rLink.getCore(circuitCore).getNumOfSlots();
+		}
+		
+		if (totalRoute > 0.0) {
+			utLocal = usedRoute / totalRoute;
+		}
+    	
+		// Utilizacao da média ponderada
+		double p = w * utLocal + ((1.0 - w) * utGlobal);
+    	
+        return p;
+    }
+    
+    /**
+     * Cálculo de potência minima
+     * 
+     * @param circuit Circuit
+     * @param P_low double
+     * @param P_high double
+     * @param cp ControlPlane
+     * @return double
+     */
+    public double computePmin(Circuit circuit, double P_low, double P_high, ControlPlane cp) {
+
+    	// ----------------------------------
+        // Parâmetros
+        // ----------------------------------
+        double OSNRtarget = circuit.getModulation().getSNRthresholdLinear();
+        double tolP       = 1e-6;   // tolerância na potência
+        double tolOSNR    = 1e-3;   // tolerância na margem OSNR
+        int ITER          = 40;     // iterações
+
+        double L = P_low;
+        double R = P_high;
+
+        // ----------------------------------
+        // (1) Teste rápido: P_low já atinge o limiar?
+        // ----------------------------------
+        circuit.setLaunchPowerLinear(L);
+        double OSNR_L = computeOSNR(circuit, cp, null, false);
+
+        if (!Double.isNaN(OSNR_L) && OSNR_L >= OSNRtarget) {
+            return L; // Já satisfaz o limiar → retorna o menor P possível
+        }
+
+        // ----------------------------------
+        // (2) Teste rápido: mesmo com P_high não atende?
+        // ----------------------------------
+        circuit.setLaunchPowerLinear(R);
+        double OSNR_R = computeOSNR(circuit, cp, null, false);
+
+        if (Double.isNaN(OSNR_R) || OSNR_R < OSNRtarget) {
+            return R; // Nem com a potência máxima atingimos o OSNR necessário.
+        }
+
+        // ----------------------------------
+        // (3) Busca binária
+        // ----------------------------------
+        double lastGood = R; // última potência válida encontrada
+
+        for (int i = 0; i < ITER; i++) {
+
+            double Pmid = (L + R) * 0.5;
+
+            circuit.setLaunchPowerLinear(Pmid);
+            double osnrMid = computeOSNR(circuit, cp, null, false);
+
+            // Segurança contra NaN, infinito ou valores esquisitos
+            if (Double.isNaN(osnrMid) || Double.isInfinite(osnrMid)) {
+                // assume que Pmid não é válida -> aumenta potência
+                L = Pmid;
+                continue;
+            }
+
+            double margin = osnrMid - OSNRtarget;
+
+            if (margin >= 0.0) {
+                // Pmid satisfaz o limiar -> salvar como "boa"
+                lastGood = Pmid;
+
+                // tentar reduzir potência
+                R = Pmid;
+
+                if (Math.abs(margin) < tolOSNR) {
+                    break; // convergência numérica da margem
+                }
+            } else {
+                // Pmid insuficiente -> aumentar potência
+                L = Pmid;
+            }
+            
+            if (Math.abs(R - L) < tolP) {
+                break; // convergiu na potência
+            }
+        }
+
+        // ----------------------------------
+        // (4) Retornar a melhor estimativa encontrada
+        // ----------------------------------
+        return lastGood;
+    }
+    
+    /**
+     * Cálculo da potência maxima
+     * 
+     * @param circuit Circuit
+     * @param cp ControlPlane
+     * @return double
+     */
+    public double computePmax(Circuit circuit, ControlPlane cp) {
+    	double Pmax = cp.getMesh().getPhysicalLayer().computeMaximumPower(circuit, circuit.getRequiredBitRate(), circuit.getRoute(), 0, circuit.getRoute().getNodeList().size() - 1, 
+				circuit.getModulation(), circuit.getIndexCore(), circuit.getSpectrumAssigned());
+    	return Pmax;
+    }
+    
+    /**
+     * Computa o OSNR do circuito informado
+     * 
+     * @param circuit Circuit
+     * @param cp ControlPlane
+     * @param testCircuit Circuit
+     * @param addTestCircuit boolean
+     * @return double
+     */
+    public double computeOSNR(Circuit circuit, ControlPlane cp, Circuit testCircuit, boolean addTestCircuit) {
+    	double osnr = cp.getMesh().getPhysicalLayer().computeSNRSegment(circuit, circuit.getRoute(), 0, circuit.getRoute().getNodeList().size() - 1, 
+				circuit.getModulation(), circuit.getIndexCore(), circuit.getSpectrumAssigned(), testCircuit, addTestCircuit);
+    	return osnr;
+    }
+    
+    /**
+     * Computa o XT do circuito informado
+     * 
+     * @param circuit Circuit
+     * @param cp ControlPlane
+     * @param testCircuit Circuit
+     * @param addTestCircuit boolean
+     * @return double
+     */
+    public double computeXT(Circuit circuit, ControlPlane cp, Circuit testCircuit, boolean addTestCircuit) {
+    	double xt = cp.getMesh().getPhysicalLayer().getCrosstalk().calculateCrosstalk(circuit, testCircuit, addTestCircuit);
+    	xt = PhysicalLayer.ratioOfDB(xt);
+    	return xt;
+    }
+}
